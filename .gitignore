# Host plugin install artifacts — generated by `npm run build` + `aet plugin init`
# (or install.sh) at install time, NOT source. Each host has its own commands/
# skills/ dir layout; committing them leaks build output into the source tree
# and gets regenerated per-user anyway. Keep them out of git.
.claude/commands/
.agents/skills/
.cac/commands/
.omp/commands/
.opencode/commands/
.sisyphus/

# npm lockfile — upstream does not commit package-lock.json (verified absent
# in upstream/master root); the project has no .npmrc pinning a lockfile
# policy either. Match upstream practice and keep it untracked.
package-lock.json

