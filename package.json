{
  "name": "aet-cli",
  "version": "0.2.0",
  "description": "AET (aet-cli): event-driven CLI + Core for orchestrating multi-agent coding workflows.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "aet": "./dist/bin/aet.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "default": "./dist/bin/aet.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./definitions": {
      "types": "./src/definitions/events.ts",
      "default": "./src/definitions/events.ts"
    },
    "./hosts/opencode": {
      "types": "./src/plugins/opencode/index.ts",
      "default": "./dist/plugins/opencode/bin/aet_handler.js"
    },
    "./hosts/claude-code": {
      "types": "./src/plugins/claude_code/index.ts",
      "default": "./dist/plugins/claude_code/handlers/aet_handler.js"
    },
    "./plugins/opencode": {
      "types": "./src/plugins/opencode/index.ts",
      "default": "./dist/plugins/opencode/bin/aet_handler.js"
    },
    "./hosts/omp": {
      "types": "./src/plugins/omp/index.ts",
      "default": "./dist/plugins/omp/bin/aet_handler.js"
    },
    "./plugins/omp": {
      "types": "./src/plugins/omp/index.ts",
      "default": "./dist/plugins/omp/bin/aet_handler.js"
    },
    "./plugins/claude-code": {
      "types": "./src/plugins/claude_code/index.ts",
      "default": "./dist/plugins/claude_code/handlers/aet_handler.js"
    }
  },
  "scripts": {
    "build": "node src/scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "node src/scripts/build.mjs",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.12.12",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
